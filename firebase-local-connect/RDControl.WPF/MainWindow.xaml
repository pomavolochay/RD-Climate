<Window
    x:Class="SecretMessage.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SecretMessage.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SecretMessage.WPF.Views"
    xmlns:vms="clr-namespace:SecretMessage.WPF.ViewModels"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    FontSize="18" 
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    Title="Secret Message"
    Width="950"
    Height="645"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None" AllowsTransparency="True"
    Background="Transparent" 
    mc:Ignorable="d">
    <Window.DataContext>
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vms:RegisterViewModel}">
                    <views:RegisterView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vms:LoginViewModel}">
                    <views:LoginView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vms:HomeViewModel}">
                    <views:HomeView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vms:PasswordResetViewModel}">
                    <views:PasswordResetView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vms:ProfileViewModel}">
                    <views:ProfileView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="1" Opacity="0.4"/>
        </Grid.Effect>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.22*"/>
        </Grid.ColumnDefinitions>

        <!--Left Section-->
        <Border Background="#FF00062D" CornerRadius="10 0 0 10" ClipToBounds="True">
            <Border.Clip>
                <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,600,650"/>
            </Border.Clip>

            <Grid>
                <!--Title-->
                <StackPanel Margin="0 120 0 0" VerticalAlignment="Top">
                    <TextBlock Text="RD Control" FontSize="46" FontWeight="Light" Foreground="#ffffff" TextAlignment="Center" FontFamily="Century Gothic"/>
                    <TextBlock Text="Чтобы работать с платформой" FontWeight="Light" FontSize="16" Foreground="#D1F2EB" TextAlignment="Center" Margin="0 15 0 3"/>
                    <TextBlock Text="пройдите авторизацию или зарегистрируйтесь" FontWeight="Light" FontSize="16" Foreground="#D1F2EB" TextAlignment="Center"/>
                </StackPanel>
                <Image Margin="50,302,50,80" Source="/Images/ITLogo.png" Stretch="Fill"/>


            </Grid>
        </Border>
        
        <!--Right Section-->
        <Border Grid.Column="1" Background="#ffffff" CornerRadius="0 10 10 0" MouseDown="Border_MouseDown">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vms:RegisterViewModel}">
                            <views:RegisterView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vms:LoginViewModel}">
                            <views:LoginView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vms:HomeViewModel}">
                            <views:HomeView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vms:PasswordResetViewModel}">
                            <views:PasswordResetView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vms:ProfileViewModel}">
                            <views:ProfileView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
