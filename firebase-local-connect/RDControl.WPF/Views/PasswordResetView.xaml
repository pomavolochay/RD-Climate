<UserControl
    x:Class="SecretMessage.WPF.Views.PasswordResetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SecretMessage.WPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>


        <!--Inputs-->
        <StackPanel VerticalAlignment="Center" Margin="75 0">
            
            <TextBox x:Name="emailTextBox" 
                     BorderThickness="0 0 0 1.5" 
                     BorderBrush="#C5C8CC" 
                     materialDesign:HintAssist.FloatingOffset="0,-20" 
                     materialDesign:HintAssist.Hint="Email" 
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0 27 0 27" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <StackPanel Orientation="Vertical" Margin="2" Cursor="">
                <Button Content="Восстановить пароль" 
                        x:Name="reg_button"
                        materialDesign:ButtonAssist.CornerRadius="22"
                        FontSize="16" 
                        Height="45" 
                        Width="215" 
                        Margin="5 0 0 0" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#FF451088" 
                        Command="{Binding SendPasswordResetEmailCommand}" 
                        Cursor="Hand" />

                <Button Content="Вернуться к авторизации" 
                        materialDesign:ButtonAssist.CornerRadius="22" 
                        FontSize="16" 
                        Height="45" 
                        Width="250" 
                        Margin="5 0 0 0" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#FFEA4949" 
                        Command="{Binding NavigateLoginCommand}"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
