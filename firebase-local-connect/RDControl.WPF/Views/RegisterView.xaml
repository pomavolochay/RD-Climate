<UserControl
    x:Class="SecretMessage.WPF.Views.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:PasswordBoxMVVM.Components;assembly=PasswordBoxMVVM"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SecretMessage.WPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>


        <!--Inputs-->
        <StackPanel VerticalAlignment="Center" Margin="75 0">
            <TextBox x:Name="userNameTextBox" 
                     BorderThickness="0 0 0 1.5" 
                     BorderBrush="#C5C8CC" 
                     materialDesign:HintAssist.FloatingOffset="0,-20" 
                     materialDesign:HintAssist.Hint="Имя пользователя" 
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <TextBox x:Name="emailTextBox" 
                     BorderThickness="0 0 0 1.5" 
                     BorderBrush="#C5C8CC" 
                     materialDesign:HintAssist.FloatingOffset="0,-20" 
                     materialDesign:HintAssist.Hint="Email" 
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0 27 0 27" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <PasswordBox x:Name="passwdTextBox" 
                         BorderThickness="0 0 0 1.5" 
                         BorderBrush="#C5C8CC" 
                         materialDesign:HintAssist.FloatingOffset="0,-18" 
                         materialDesign:HintAssist.Hint="Пароль" 
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" 
                         PasswordChanged="passwdTextBox_PasswordChanged" />

            <PasswordBox x:Name="retypePasswdTextBox" 
                         BorderThickness="0 0 0 1.5" BorderBrush="#C5C8CC" 
                         materialDesign:HintAssist.FloatingOffset="0,-18" 
                         materialDesign:HintAssist.Hint="Повторите пароль" 
                         Password="" 
                         Margin="0 27 0 0" 
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" PasswordChanged="retypePasswdTextBox_PasswordChanged" />

            <CheckBox Margin="0 40 0 20" FontSize="13" Background="#FF0B296B" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked">
                <TextBlock>
                            <Run Foreground="#b6b6b6">Регистрируясь Я соглашаюсь</Run>
                            <Hyperlink Foreground="#FFEA4949" NavigateUri="https://github.com/pomavolochay/RD-Climate">c условиями</Hyperlink>
                </TextBlock>
            </CheckBox>

            <StackPanel Orientation="Horizontal" Margin="2" Cursor="">
                <Button Content="Зарегистрироваться" 
                        x:Name="reg_button"
                        materialDesign:ButtonAssist.CornerRadius="22"
                        FontSize="16" 
                        Height="45" 
                        Width="215" 
                        Margin="5 0 0 0" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#FF451088" 
                        Command="{Binding SubmitCommand}" 
                        Cursor="Hand" IsEnabled="False"/>

                <Button Content="Войти" 
                        materialDesign:ButtonAssist.CornerRadius="22" 
                        FontSize="16" 
                        Height="45" 
                        Width="120" 
                        Margin="5 0 0 0" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#FFEA4949" 
                        Command="{Binding NavigateLoginCommand}" 
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
